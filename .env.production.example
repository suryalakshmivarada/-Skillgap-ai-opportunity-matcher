# ==============================================================================
# Production Environment Variables - Frontend (Vite)
# ==============================================================================
# Set in your frontend hosting dashboard (Vercel, Netlify, Cloudflare Pages, AWS Amplify).

# Base URL pointing to the deployed Express backend API (MUST be HTTPS in production)
VITE_API_BASE_URL=https://your-production-backend.railway.app

# Public application name
VITE_APP_NAME=AI Opportunity Matcher
