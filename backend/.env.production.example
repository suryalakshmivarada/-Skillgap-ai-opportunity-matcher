# ==============================================================================
# Production Environment Variables - Backend API
# ==============================================================================
# Set these variables in your production hosting platform (e.g. Render, Railway, AWS ECS).

# Environment mode
NODE_ENV=production

# Server Port (Render/Railway/Heroku inject PORT automatically)
PORT=5000

# CORS Whitelist: Exact HTTPS domain(s) of the deployed frontend
# Comma-separated if multiple domains: e.g. https://aiopportunity.vercel.app,https://www.aiopportunity.com
CORS_ORIGIN=https://your-production-frontend.vercel.app

# JWT Secret for signing student authentication tokens (use a strong random 32+ char key)
JWT_SECRET=YOUR_PRODUCTION_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Neon PostgreSQL Database Connection Strings
# Always use the AWS Neon Pooler connection string in production to support concurrency & autoscaling
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/[DBNAME]?channel_binding=require&sslmode=require"

# Direct URL for running prisma migrate deploy in CI/CD pipeline
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/[DBNAME]?channel_binding=require&sslmode=require"

# Google Gemini API
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
